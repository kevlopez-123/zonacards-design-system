    "auth.bloqMayus": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloq Mayús está activado."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lock is on."
          }
        }
      }
    },
    "auth.bloqueo.texto": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por seguridad, después de 5 intentos fallidos podrás volver a intentarlo en %1$@, o restablecer tu contraseña ahora."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For security, after 5 failed attempts you can try again in %1$@, or reset your password now."
          }
        }
      },
      "comment": "Argumentos: tiempo"
    },
    "auth.bloqueo.titulo": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta bloqueada temporalmente"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account temporarily locked"
          }
        }
      }
    },
