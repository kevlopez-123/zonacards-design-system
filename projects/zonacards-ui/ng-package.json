{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/zonacards-ui",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    { "input": "styles", "glob": "**/*.css", "output": "styles" },
    { "input": "i18n", "glob": "*.json", "output": "i18n" },
    { "input": "assets", "glob": "**/*", "output": "assets" },
    { "input": "skills", "glob": "**/*.md", "output": "skills" },
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "allowedNonPeerDependencies": ["@tanstack/angular-table", "class-variance-authority", "clsx", "tailwind-merge", "tslib"]
}
